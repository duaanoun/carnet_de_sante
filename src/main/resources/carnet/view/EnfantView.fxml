<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="carnet.controller.EnfantController"
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11;">

    <!-- HAUT : Titre -->
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label text="Gestion des Enfants" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <!-- CENTRE : Table + Formulaire -->
    <center>
        <HBox spacing="10" style="-fx-padding: 15;">
            <!-- Colonne gauche : Table -->
            <VBox HBox.hgrow="ALWAYS" spacing="10">
                <Label text="Liste des enfants" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                <TableView fx:id="tableEnfants" style="-fx-font-size: 10;">
                    <columns>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="120"/>
                        <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="120"/>
                        <TableColumn fx:id="colDateNaissance" text="Date Naissance" prefWidth="140"/>
                        <TableColumn fx:id="colSexe" text="Sexe" prefWidth="60"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Colonne droite : Formulaire -->
            <VBox spacing="10" style="-fx-border-left: 1 solid #ccc; -fx-padding-left: 15;" prefWidth="300">
                <Label text="Formulaire" style="-fx-font-weight: bold; -fx-font-size: 12;"/>

                <VBox spacing="5">
                    <Label text="Nom" style="-fx-font-size: 10;"/>
                    <TextField fx:id="champNom" promptText="Dupont"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Prénom" style="-fx-font-size: 10;"/>
                    <TextField fx:id="champPrenom" promptText="Alice"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Date de naissance" style="-fx-font-size: 10;"/>
                    <DatePicker fx:id="champDateNaissance"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Sexe" style="-fx-font-size: 10;"/>
                    <ChoiceBox fx:id="champSexe" prefWidth="200"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Groupe sanguin" style="-fx-font-size: 10;"/>
                    <TextField fx:id="champGroupeSanguin" promptText="O+"/>
                </VBox>

                <HBox spacing="10" style="-fx-padding-top: 10;">
                    <Button text="➕ Ajouter" onAction="#onAjouter" style="-fx-padding: 8; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Button text="✏️ Modifier" onAction="#onModifier" style="-fx-padding: 8; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Button text="🗑️ Supprimer" onAction="#onSupprimer" style="-fx-padding: 8; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

    <!-- BAS : Barre de menu -->
    <bottom>
        <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #ecf0f1;">
            <Hyperlink text="Vaccinations" style="-fx-font-size: 11;"/>
            <Hyperlink text="Consultations" style="-fx-font-size: 11;"/>
            <Hyperlink text="Historique" style="-fx-font-size: 11;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Connecté" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>
</BorderPane>
